[
  {
    "id": "sociedade",
    "label": {
      "pt": "Sociedade",
      "en": "Society",
      "fr": "Société"
    },
    "text": {
      "pt": "A sociedade deve se apoiar em quê?",
      "en": "What should society rest on?",
      "fr": "Sur quoi la société devrait-elle reposer ?"
    },
    "options": [
      {
        "id": "A",
        "text": {
          "pt": "Fé, família e tradição da nação",
          "en": "Faith, family and national tradition",
          "fr": "La foi, la famille et les traditions nationales"
        },
        "effects": {
          "moral": 12,
          "religiao": 20,
          "imigracao": 82
        }
      },
      {
        "id": "B",
        "text": {
          "pt": "Costumes e fé, mudando devagar",
          "en": "Custom and faith, changing slowly",
          "fr": "Les coutumes et la foi, en évoluant progressivement"
        },
        "effects": {
          "moral": 32,
          "religiao": 42,
          "imigracao": 60
        }
      },
      {
        "id": "C",
        "text": {
          "pt": "Cada um vive como quiser",
          "en": "Live and let live",
          "fr": "Chacun vit comme il l’entend"
        },
        "effects": {
          "moral": 55,
          "religiao": 60,
          "imigracao": 40
        }
      },
      {
        "id": "D",
        "text": {
          "pt": "Igualdade, diversidade e direitos civis",
          "en": "Equality, diversity and civil rights",
          "fr": "L’égalité, la diversité et les droits civiques"
        },
        "effects": {
          "moral": 80,
          "religiao": 75,
          "imigracao": 20
        }
      },
      {
        "id": "E",
        "text": {
          "pt": "Tradição e ordem, sem religião",
          "en": "Tradition and order, without religion",
          "fr": "La tradition et l’ordre, sans religion"
        },
        "effects": {
          "moral": 25,
          "religiao": 82,
          "imigracao": 65
        }
      },
      {
        "id": "F",
        "text": {
          "pt": "Fé a serviço da justiça social",
          "en": "Faith in service of social justice",
          "fr": "La foi au service de la justice sociale"
        },
        "effects": {
          "moral": 72,
          "religiao": 25,
          "imigracao": 30
        }
      }
    ]
  },
  {
    "id": "poder",
    "label": {
      "pt": "Poder",
      "en": "Power",
      "fr": "Pouvoir"
    },
    "text": {
      "pt": "Como o poder deve ser organizado?",
      "en": "How should power be organized?",
      "fr": "Comment le pouvoir devrait-il être organisé ?"
    },
    "options": [
      {
        "id": "A",
        "text": {
          "pt": "Líder ou partido único, centralizado",
