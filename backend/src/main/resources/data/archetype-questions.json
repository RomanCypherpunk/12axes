          "de": "Glaube, Familie und nationale Tradition"
        },
        "effects": {
          "moral": 12,
          "religiao": 20,
          "imigracao": 82
        }
      },
      {
        "id": "B",
        "text": {
          "pt": "Costumes e fé, mudando devagar",
