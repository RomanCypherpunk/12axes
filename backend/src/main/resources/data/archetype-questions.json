          "fr": "Un dirigeant ou un parti unique, avec un pouvoir centralisé"
        },
        "effects": {
          "representacao": 15,
          "estrutura": 18,
          "poder": 85
        }
      },
      {
        "id": "B",
        "text": {
          "pt": "Elites decidem, com voto limitado",
          "en": "Elites decide, with limited voting",
          "fr": "Les élites décident, avec un droit de vote limité"
        },
        "effects": {
          "representacao": 40,
          "estrutura": 38,
          "poder": 65
