          "fr": "Une démocratie avec des contre-pouvoirs"
        },
        "effects": {
          "representacao": 78,
          "estrutura": 45,
          "poder": 42
        }
      },
      {
        "id": "D",
        "text": {
          "pt": "Estado mínimo ou nenhum",
          "en": "Little or no state",
          "fr": "Un État minimal ou inexistant"
        },
        "effects": {
          "representacao": 70,
          "estrutura": 88,
          "poder": 12
        }
      },
      {
        "id": "E",
        "text": {
          "pt": "Sem Estado, conselhos ou contratos",
          "en": "No state, councils or contracts",
          "fr": "Aucun État : des conseils ou des contrats"
        },
        "effects": {
          "representacao": 90,
          "estrutura": 95,
          "poder": 8
        }
      }
    ]
  },
