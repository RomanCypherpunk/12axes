          "de": "Gleichheit, Vielfalt und Bürgerrechte"
        },
        "effects": {
          "moral": 80,
          "religiao": 75,
          "imigracao": 20
        }
      },
      {
        "id": "E",
        "text": {
          "pt": "Tradição e ordem, sem religião",
