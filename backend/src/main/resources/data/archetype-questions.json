[
  {
    "id": "sociedade",
    "label": {
      "pt": "Sociedade",
      "en": "Society",
      "de": "Gesellschaft"
    },
    "text": {
      "pt": "A sociedade deve se apoiar em quê?",
      "en": "What should society rest on?",
      "de": "Worauf sollte die Gesellschaft beruhen?"
    },
    "options": [
      {
        "id": "A",
