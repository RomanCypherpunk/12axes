VITE_API_URL=https://one2axes-backend.onrender.com

# Opcional: raiz de public/ numa CDN própria para as imagens do catálogo. Vazia, usa VITE_ASSETS_CDN (a mesma que serve
# /assets); sem as duas, as imagens vêm do próprio site.
# VITE_ASSET_BASE=

# Compra do Relatório completo (só em português). true = todo mundo; preview = só quem abrir o site com ?paywall=1 (?paywall=0 desmarca);
# paused = vendas pausadas (ninguém vê a compra, mas quem já pagou continua com o relatório);
# vazio = ninguém (padrão; quem já pagou perde o acesso). O backend tem o seu próprio interruptor (PAYMENTS_ENABLED).
# VITE_PAYWALL_ENABLED=
# Compra em inglês (dólar, pela Paddle), mesmos valores; e o token do lado do cliente da Paddle (test_... no sandbox, live_...).
# VITE_PAYWALL_EN_ENABLED=
# VITE_PADDLE_CLIENT_TOKEN=

