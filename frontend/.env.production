# Variáveis PÚBLICAS do build de produção (VITE_* vai para o JS que o navegador baixa; nada secreto mora aqui).
#
# O site tem dois builds do mesmo commit: a Vercel (HTML) e o Cloudflare Pages (JS, CSS, imagens). O navegador usa o JS do
# Cloudflare, então o comportamento do app é o do build DELE. Quando uma variável existia só no painel de uma das duas
# plataformas, os builds divergiam em silêncio (o paywall ficou desligado no Cloudflare e o site perdeu a compra e o link
# de gift). Por isso o que define o comportamento do app fica aqui, no repositório, que as duas leem. O valor do painel,
# se houver, vence este arquivo.

# Compra do Relatório completo em português (reais). Ver src/utils/paywallFlag.ts.
# paused = vendas pausadas: ninguém vê a compra, mas quem já pagou continua com o relatório. true = todo mundo pode comprar.
# (Vazio apagaria o acesso de quem pagou: não use.)
VITE_PAYWALL_ENABLED=true

# Compra em inglês (dólar, pela Paddle), com os mesmos valores. preview = só quem abrir o site com ?paywall=1 vê a compra;
# vazio = desligada.
VITE_PAYWALL_EN_ENABLED=true

# Token do lado do cliente da Paddle (público por desenho): test_... é do sandbox, live_... é da produção. Ao abrir as vendas
# de verdade, troque pelo token live_ e a chave de API no Render pela de produção.
VITE_PADDLE_CLIENT_TOKEN=live_0be189fff7c6c85a88bed7e4df8

# API (Render).
VITE_API_URL=https://one2axes-backend.onrender.com

# CDN que serve /assets, imagens do catálogo, ícones e dados da teia (o Cloudflare Pages). Se ela falhar, o site usa a cópia
# local (ver src/utils/assetUrl.ts e vite.config.ts).
VITE_ASSETS_CDN=https://12axes-6b7.pages.dev

# Imagens do catálogo saem da CDN acima. Para voltar ao jsDelivr, descomente a linha abaixo (imagem nova só aparece nele
# depois do push):
# VITE_ASSET_BASE=https://cdn.jsdelivr.net/gh/RomanCypherpunk/12axes@main/frontend/public
