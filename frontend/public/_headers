# Cabeçalhos do Cloudflare Pages (na Vercel este arquivo é ignorado). Os arquivos de /assets são pedidos de outro
# domínio (o site na Vercel), então precisam de CORS: scripts de módulo e fontes falham sem ele.
/assets/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=31536000, immutable

/personalities/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=2592000

/countries/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=2592000

/parties/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=2592000

/share-examples/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=2592000

# Ícones do site: a Vercel entrega o HTML e aponta para estes arquivos, que moram aqui (ver iconCdnPlugin e site-icons.mjs).
/favicon.ico
  Cache-Control: public, max-age=2592000

/favicon-32x32.png
  Cache-Control: public, max-age=2592000

/apple-touch-icon.png
  Cache-Control: public, max-age=2592000
